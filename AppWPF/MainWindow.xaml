<Window x:Class="AppWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistema de Cadastro - Gabriel Francisco Rocha - github.com/dev-Gabe" Height="500" Width="750" 
        WindowStartupLocation="CenterScreen" Background="#f0f0f0">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Lado esquerdo: Cadastro -->
        <StackPanel Grid.Column="0" Margin="0,0,15,0">
            <TextBlock Text="Novo Contato" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
            
            <TextBlock Text="Nome:"/>
            <TextBox x:Name="txtNome" Margin="0,5,0,10" Padding="5"/>

            <TextBlock Text="Sobrenome:"/>
            <TextBox x:Name="txtSobrenome" Margin="0,5,0,10" Padding="5"/>

            <TextBlock Text="Telefone:"/>
            <TextBox x:Name="txtTelefone" Margin="0,5,0,15" Padding="5"/>

            <Button Content="Salvar" Click="Add_Click" Height="35" Background="#28a745" Foreground="White" FontWeight="Bold" Margin="0,0,0,10"/>
            <Button Content="Limpar Tudo" Click="Clear_Click" Height="30" Background="#6c757d" Foreground="White"/>
        </StackPanel>

        <!-- Lado direito: Lista -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Contatos Salvos" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

            <DataGrid x:Name="gridPessoas" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" 
                      SelectionMode="Single" Background="White" AlternatingRowBackground="#f9f9f9">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding id}" Width="40"/>
                    <DataGridTextColumn Header="Nome" Binding="{Binding nome}" Width="*"/>
                    <DataGridTextColumn Header="Sobrenome" Binding="{Binding sobrenome}" Width="*"/>
                    <DataGridTextColumn Header="Telefone" Binding="{Binding telefone}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="Atualizar" Click="Update_Click" Width="100" Height="35" Margin="0,0,10,0" Background="#007bff" Foreground="White" FontWeight="Bold"/>
                <Button Content="Deletar" Click="Delete_Click" Width="100" Height="35" Background="#dc3545" Foreground="White" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
